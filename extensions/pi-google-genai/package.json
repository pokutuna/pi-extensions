{
  "name": "@pokutuna/pi-google-genai",
  "version": "0.0.1",
  "private": false,
  "description": "Pi extension that adds Google GenAI grounding tools: google_search, google_maps, and url_context.",
  "keywords": [
    "gemini",
    "genai",
    "google",
    "maps",
    "pi",
    "pi-extension",
    "pi-package",
    "search"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pokutuna/pi-extensions",
    "directory": "extensions/pi-google-genai"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@google/genai": "^2.10.0",
    "typebox": "^1.3.6"
