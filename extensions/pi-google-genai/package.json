{
  "name": "@pokutuna/pi-google-genai",
  "version": "0.1.0",
  "private": false,
  "description": "Pi extension that adds Google GenAI grounding tools: google_search, google_maps, url_context, and deep_research.",
  "keywords": [
    "gemini",
    "genai",
    "google",
    "maps",
    "pi",
    "pi-extension",
    "pi-package",
    "search"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pokutuna/pi-extensions.git",
    "directory": "extensions/pi-google-genai"
  },
  "homepage": "https://github.com/pokutuna/pi-extensions/tree/main/extensions/pi-google-genai#readme",
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "scripts": {
