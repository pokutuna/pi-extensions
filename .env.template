# Copy/generate this into .env; `pi` does not load .env automatically.
#
# `make env` runs op inject to resolve the secret references below into .env.
# Without 1Password, copy this file to .env by hand and fill in real values instead.

# API key for https://openrouter.ai/keys
# Used by .pi-agent-dir/models.json (see docs/openrouter-free-model.md)
OPENROUTER_API_KEY=OPENROUTER_API_KEY_OP_REF

# Points pi at .pi-agent-dir/ instead of ~/.pi/agent/, so defaultProvider/defaultModel
# (.pi-agent-dir/settings.json) apply without touching global pi settings.
# See docs/openrouter-free-model.md
PI_CODING_AGENT_DIR=./.pi-agent-dir
